{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS AI Assistant - Desktop Application",
  "main": "public/main.js",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-dev-updater": "^1.3.4"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "wait-on http://localhost:3000 && electron .",
    "electron-dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run react-build && electron-builder",
    "start": "npm run electron-dev",
    "build": "npm run electron-build"
  },
  "build": {
    "appId": "com.jarvis-ai.app",
    "productName": "JARVIS AI",
    "files": [
      "build/**/*",
      "public/main.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devEngines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
